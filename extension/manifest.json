{
  "manifest_version": 3,
  "name": "동국대 AI Assistant",
  "version": "0.1.0",
  "description": "nDRIMS 화면에서 동국대학교 학사 안내와 메뉴를 빠르게 찾습니다.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://ndrims.dongguk.edu/*", "http://127.0.0.1:8000/*"],
  "content_scripts": [{
    "matches": ["https://ndrims.dongguk.edu/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["panel.html"],
    "matches": ["https://ndrims.dongguk.edu/*"]
  }]
}
